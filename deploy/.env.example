# Copy to .env and fill in before running docker compose up.

# Signs session cookies — required, at least 32 characters, startup fails
# without a real value (a placeholder like "change-me" is rejected too).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SR_SECRET_KEY=

# If set and no users exist yet, this account is created at startup.
SR_ADMIN_EMAIL=you@example.com
SR_ADMIN_PASSWORD=change-me

# Set to false only for plain-http LAN testing without a reverse proxy.
SR_SECURE_COOKIES=true
