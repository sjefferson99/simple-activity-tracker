# Copy to .env and fill in before running docker compose up.
# Every setting is an SR_-prefixed env var read by server/app/config.py —
# this file documents all of them, not just the ones you're likely to change.
#
# This plain compose file is for local development/CI only (no reverse
# proxy) and has no `secrets:` block wired up, so SR_SECRET_KEY and
# SR_ADMIN_PASSWORD are just set here directly. For a real deployment, use
# deploy/standalone-tls instead, which sources SR_SECRET_KEY from a Docker
# Compose secrets file rather than a plain env var — see its README.md
# "Secrets" section and .env.example for the pattern.

# --- Required ---

# Signs session cookies — required, at least 32 characters, startup fails
# without a real value (a placeholder like "change-me" is rejected too).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SR_SECRET_KEY=

# --- First-boot admin bootstrap ---

# If set and no users exist yet, this account is created at startup.
# Only takes effect once, on the very first boot with an empty database —
# editing it later does NOT reset the admin's password. To change the admin
# password afterwards, sign in and use /settings (or the admin API/UI). The
# app warns at startup if this is still set once users already exist, since
# it does nothing past that first boot — comment it out once bootstrapped.
SR_ADMIN_EMAIL=you@example.com
SR_ADMIN_PASSWORD=change-me

# --- Cookies ---

# Set to false only for plain-http LAN testing without a reverse proxy —
# a Secure cookie is silently dropped by browsers/clients over plain HTTP.
# Leave true for anything reachable over the internet.
SR_SECURE_COOKIES=true

# --- Optional features ---

# Enables self-service account creation at /register. Off by default —
# turn on only for a deployment where you want people to sign themselves up
# (e.g. a shared household/team instance); otherwise create accounts via the
# admin UI (/admin/users) or API.
# SR_ALLOW_REGISTRATION=false

# Maximum accepted GPX upload size, in bytes. Default is 20 MB
# (20 * 1024 * 1024 = 20971520), generous for even a multi-hour activity.
# SR_MAX_GPX_BYTES=20971520

# Enables the interactive API docs at /api/docs and the raw schema at
# /api/openapi.json, and includes the app version in /healthz's response.
# Off by default — these disclose version info and API shape to anyone who
# can reach the server. Turn on temporarily for local debugging only; the
# committed server/openapi.json is the mobile app's real contract regardless
# of this setting.
# SR_ENABLE_API_DOCS=false

# --- Reverse proxy / networking ---

# Comma-separated list of proxy IPs/subnets trusted to set X-Forwarded-*
# headers (client IP, proto). Leave unset for this plain compose file, which
# has no reverse proxy in front of it — only set this if you put your own
# proxy in front of `app` (see standalone-tls/ for a worked example with a
# bundled proxy already configured).
# SR_TRUSTED_PROXIES=

# --- Logging ---

# Log verbosity for the app's own logger and the audit trail: debug, info,
# warning, or error. info is a sensible default for production.
# SR_LOG_LEVEL=info

# --- Storage (advanced — leave unset) ---

# These default to sqlite:////data/simple_activity_tracker.db and /data, matching the
# ./data:/data bind mount in docker-compose.yml. Only override them if you
# also change that mount to match — otherwise the app will write somewhere
# the bind mount doesn't cover and data won't persist across restarts.
# SR_DATABASE_URL=sqlite:////data/simple_activity_tracker.db
# SR_DATA_DIR=/data

# --- Migrations and backups ---

# When true (default), `run` backs up the database + GPX blobs (see
# SR_BACKUP_DIR below) before applying pending migrations at startup, and
# always migrates automatically. Set to false to require migrations be
# applied out-of-band (`simple-activity-tracker-server migrate`) before the
# app is allowed to start — it refuses to start otherwise.
# SR_AUTO_MIGRATE=true

# Only relevant when SR_AUTO_MIGRATE=true. Set to false to skip the
# pre-migration backup (not recommended).
# SR_BACKUP_BEFORE_MIGRATE=true

# Where `simple-activity-tracker-server backup` (automatic pre-migration
# backups, and manual ones via `docker compose run --rm app
# simple-activity-tracker-server backup /backups`) writes timestamped backup
# subdirectories. Defaults to /backups, matching the ./backups:/backups bind
# mount in docker-compose.yml — override only if you also change that mount.
# SR_BACKUP_DIR=/backups
